# Python virtual environment (NEVER push this — it's huge and machine-specific)
venv/
__pycache__/
*.pyc

# Logs
*.log

# Generated reports/exports (delivered by email; not needed in the repo)
reports_out/

# Local secrets — must never be committed
.streamlit/secrets.toml
.env

# Keep psx_engine.db tracked: the Actions runner commits it so the dashboard
# shows fresh data. (It is intentionally NOT ignored.)

# Article body text fetched for the news Routine's deep read. Deliberately NOT
# tracked: ~50 full articles committed on every hourly run would be hundreds of
# KB of churn per hour — the same tracked-size problem that took psx_engine.db
# to 54 MB. The Routine regenerates it in-container each time it needs it.
news_bodies.json
private_depth/

# Retired/runtime database archives do not belong in the source checkout.
# Existing copies remain recoverable from Git history; future archives stay local/artifact-only.
archive_*.db

psx_engine.db
intraday_observations.db
short_horizon_inputs.json
