index 0000000..d7f4cc5
--- /dev/null
+++ b/.github/workflows/candle-research.yml
@@ -0,0 +1,116 @@
+name: PSX Candle Research
+
+# Research follows evening grading. A 23:20 PKT weekday backup covers a missed
+# evening trigger. GitHub schedules may be delayed; freshness is checked below.
+on:
+  workflow_run:
+    workflows: [PSX Evening Summary]
+    types: [completed]
+    branches: [main]
+  schedule:
+    - cron: '20 18 * * 1-5'
+  workflow_dispatch: {}
+
+permissions:
+  contents: write
+
+concurrency:
+  group: psx-candle-research
+  cancel-in-progress: false
+
+jobs:
+  research:
+    if: >-
+      github.event_name != 'workflow_run' ||
+      (github.event.workflow_run.conclusion == 'success' &&
+       github.event.workflow_run.head_repository.full_name == github.repository)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    env:
+      TZ: Asia/Karachi
+    steps:
+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09
+        with:
+          ref: main
+          fetch-depth: 0
+      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
+        with:
+          python-version: '3.12'
+          cache: pip
+      - name: Install research dependencies
+        run: pip install -r requirements-ci.txt 'plotly>=5,<7'
+      - name: Test frozen research method
+        run: python -m unittest discover -s tools/candle_research -v
+      - name: Extract read-only data snapshots
+        run: |
+          python - <<'PY'
+          import json, os, subprocess
+          from pathlib import Path
+          directory = Path(os.environ['RUNNER_TEMP']) / 'candle-data'
+          directory.mkdir()
+          errors = {}
+          for branch in ['main', 'runtime-state']:
+              ref = 'origin/' + branch
+              commit = 'unavailable'
+              try:
+                  subprocess.run(['git', 'fetch', 'origin', branch], check=True, capture_output=True)
+                  commit = subprocess.check_output(['git', 'rev-parse', ref], text=True).strip()
+                  data = subprocess.check_output(['git', 'show', ref + ':psx_engine.db'], stderr=subprocess.PIPE)
+                  (directory / (branch + '.db')).write_bytes(data)
+              except subprocess.CalledProcessError as exc:
+                  errors[branch] = 'Snapshot fetch/extraction failed (exit ' + str(exc.returncode) + ')'
+              with open(os.environ['GITHUB_ENV'], 'a') as env:
+                  env.write(branch.upper().replace('-', '_') + '_DATA_COMMIT=' + commit + '\n')
+          (directory / 'extraction-errors.json').write_text(json.dumps(errors))
+          PY
+      - name: Save dated evidence and frozen research ideas
+        run: |
+          # Configured calendar is a proxy while official holidays are incomplete.
+          expected=$(python -c 'from session_calendar import last_completed; print(last_completed())')
+          python tools/candle_research/daily.py --repo . \
+            --database "main=$RUNNER_TEMP/candle-data/main.db=$MAIN_DATA_COMMIT" \
+            --database "runtime-state=$RUNNER_TEMP/candle-data/runtime-state.db=$RUNTIME_STATE_DATA_COMMIT" \
+            --expected-session "$expected" \
+            --extraction-errors "$RUNNER_TEMP/candle-data/extraction-errors.json" \
+            --output "$RUNNER_TEMP/candle-report" \
+            --checkpoints docs/candle-research/checkpoints \
+            || { researchCode=$?; [ "$researchCode" -eq 2 ] || exit "$researchCode"; }
+          git diff --exit-code -- psx_engine.db portfolio.json
+      - name: Preserve detailed research artifacts
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: candle-research-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/candle-report/
+          retention-days: 90
+          if-no-files-found: warn
+      - name: Publish evidence only from the cloud
+        run: |
+          if [ ! -d docs/candle-research/checkpoints ]; then
+            echo "No readable dataset; see the unavailable report artifact."
+            exit 0
+          fi
+          git config user.name "psx-candle-research"
+          git config user.email "actions@users.noreply.github.com"
+          git add -- docs/candle-research/checkpoints
+          if git diff --cached --quiet; then
+            echo "Dataset and method unchanged; no duplicate checkpoint."
+            exit 0
+          fi
+          git commit -m "Candle research evidence $(date -u +'%Y-%m-%dT%H:%MZ')"
+          python runtime_publish.py main
+      - name: Report freshness and validation status
+        if: always()
+        run: |
+          if [ -f "$RUNNER_TEMP/candle-report/summary.md" ]; then
+            cat "$RUNNER_TEMP/candle-report/summary.md" >> "$GITHUB_STEP_SUMMARY"
+          fi
+          if [ -f "$RUNNER_TEMP/candle-report/status.json" ]; then
+            python - <<'PY'
+          import json, os
+          from pathlib import Path
+          status = json.loads((Path(os.environ['RUNNER_TEMP'])/'candle-report/status.json').read_text())
+          if status.get('status') == 'unavailable':
+              raise SystemExit('No fresh completed-session research: inspect the saved status.')
+          PY
+          fi
